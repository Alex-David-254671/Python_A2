def insertionSort(numbers):
    for i in range(1, len(numbers)):
        key = numbers[i]
        j = i - 1

        while j >= 0 and numbers[j] > key:
            numbers[j + 1] = numbers[j]
            j = j - 1

        numbers[j + 1] = key

    return numbers


numbers = [17, 13, 18, 12,16,14, 15]

print(insertionSort(numbers))
