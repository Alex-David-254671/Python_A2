def binarySearch(numbers, target):
    low = 0
    high = len(numbers) - 1

    while low <= high:
        mid = (low + high) // 2

        if numbers[mid] == target:
            return mid
        elif numbers[mid] < target:
            low = mid + 1
        else:
            high = mid - 1

    return -1


numbers = [1450, 3520, 4530, 5050, 6950,7860, 8070, 8980, 9000]

result = binarySearch(numbers, 8070)

print(result)
