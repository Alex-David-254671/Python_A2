def binarySearch(numbers, target):
    lowerbound = 0
    upperbound = len(numbers) - 1

    while lowerbound <= upperbound:
        mid = (lowerbound + upperbound) // 2

        if numbers[mid] == target:
            return mid
        elif numbers[mid] < target:
            lowerbound = mid + 1
        else:
            upperbound = mid - 1

    return "item not here"

Target=int(input("enter the item to find:"))
numbers = [1450, 3520, 4530, 5050, 6950,7860, 8070, 8980, 9000]

result = binarySearch(numbers, Target)

print(result)
